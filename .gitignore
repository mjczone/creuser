tmp/
node_modules/

# .NET
bin/
obj/
*.user
.vs/
TestResults/

# SPA build output is emitted into Creuser.Web/wwwroot by `quasar build`
# (see quasar.config.ts → build.distDir). Don't commit the artifacts.
src/Creuser.Web/wwwroot/

# Per-developer ASP.NET Core settings overrides — populated by
# `npm run services:up` with the random host ports of the dev containers.
appsettings.*.local.json

# Local dev data dir — branding assets, secret files, data-protection keys,
# checked-out workspaces, plugin DLLs, etc. Mirrors the production /data
# volume at <repo>/.data/ when running outside the container.
/.data/

# Claude Code ephemeral session state — scheduled-task locks, agent caches,
# subagent output. Project-level config (CLAUDE.md, agents/, skills/) can be
# committed selectively if you want them shared; the lock + tasks dirs stay
# local-only.
/.claude/scheduled_tasks.lock
/.claude/tasks/
/.claude/.cache/
