<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Explicit package source pinning. The <clear/> wipes any machine-wide
    sources the runtime would otherwise inherit (system NuGet config, OS-
    level config, GitHub Actions runner injections, corporate proxies),
    and the only source we add back is the public nuget.org v3 feed.

    Why pin: the Docker build hit `dotnet restore` failures on GitHub
    Actions where the runner's environment was leaking unrelated package
    sources into the resolution path. With <clear/> in place, both the
    Docker build and the runner-side CI restore against exactly the same
    feed regardless of host config.

    Bump to a private feed (Azure Artifacts, GitHub Packages, internal
    Nexus) by adding another <add> entry. Keep <clear/> at the top so
    behavior stays explicit; never rely on inherited config.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <!--
    Wildcard mapping so any package resolves to nuget.org only. With
    multiple feeds added later, narrow this with explicit patterns
    (e.g. <package pattern="Microsoft.*" /> against nuget.org, then
    <package pattern="MyOrg.*" /> against an internal feed) so a typo'd
    package name can't silently pull from the wrong source.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
